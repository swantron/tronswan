# Vite Environment Variables
# Vite Environment Variables
# Copy this file to .env and fill in your actual values

# OpenWeatherMap API Configuration
VITE_WEATHER_API_KEY=your_openweathermap_api_key_here
VITE_WEATHER_CITY=Bozeman
VITE_WEATHER_UNITS=imperial

# Site Configuration
VITE_SITE_URL=https://tronswan.com

# SECURITY: every VITE_* variable is baked into the public JS bundle.
# Never put a token or secret in a VITE_* variable (the build refuses to).
# Secrets below are runtime-only env vars read by server.js.

# GitHub Configuration (server.js proxy)
# No token: the status page only reads public repos, unauthenticated.
GITHUB_OWNER=swantron

# DigitalOcean Configuration (server.js proxy)
# Create a token with 'read' scope only
DIGITALOCEAN_TOKEN=your_digitalocean_token_here
DIGITALOCEAN_APP_ID=your_digitalocean_app_id_here

# Google Docs API Configuration
# Get your Google Docs API key from: https://console.cloud.google.com/
# See GOOGLE_DOCS_SETUP.md for detailed setup instructions
VITE_GOOGLE_DOCS_API_KEY=your_google_docs_api_key_here

# Spotify Configuration
# Client secret is server-only (server.js /api/health/spotify)
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_REDIRECT_URI=https://tronswan.com/music/callback

# For production, update the redirect URI to your domain:
# VITE_SPOTIFY_REDIRECT_URI=https://tronswan.com/music/callback

# Swantron Blog API
VITE_SWANTRON_API_URL=https://swantron.com

# watchtron white-box tracing (server-side, set in DigitalOcean App Platform env)
# Tracing is a no-op unless WATCHTRON_OTLP_ENDPOINT is set.
WATCHTRON_OTLP_ENDPOINT=https://watch.swantron.com
WATCHTRON_TOKEN=your_watchtron_token_here
# Must match the registry expectedServiceName for tronswan.
WATCHTRON_SERVICE_NAME=tronswan-web